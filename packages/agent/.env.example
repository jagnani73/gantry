# Signing
AGENT_SESSION_KEY!      # the agent's session key — its address is the wallet's agentSigner

# Backend
GANTRY_API=http://localhost:4000

# LLM (optional — absent = scripted mode)
GOOGLE_GENERATIVE_AI_API_KEY    # Google AI Studio key (free tier)
AGENT_LLM_TIMEOUT_MS=8000       # ms without a real stream part before the scripted fallback; only fires while no tool has run, so a payment cannot run twice
