# Signing
AGENT_SESSION_KEY!      # the agent's session key — its address is the wallet's agentSigner
AGENT_WALLET            # optional; pin the wallet to act through. createWallet is permissionless, so anyone can mint a newer one naming your signer
AGENT_PAY_TOKEN=USDC|EURC   # default: USDC — one currency per agent; the wallet's caps are a single number in this token's units
AGENT_USE_PAY_LINK=0|1      # default: 0 — 1 pays GET /pay/:handle, the same URL a person opens, instead of POST /api/order/:handle

# Backend
GANTRY_API=http://localhost:4000

# LLM (optional — no key at all = scripted mode). AISA_API_KEY wins when both are set.
GOOGLE_GENERATIVE_AI_API_KEY    # Google AI Studio key (free tier)
AISA_API_KEY                    # AIsa gateway key from console.aisa.one/api-keys; requires AISA_MODEL or startup fails
AISA_MODEL                      # e.g. qwen-flash. MUST do native tool calling; of the 7 no-balance ids only the 5 chat ones qualify (2 are embeddings), and the other 97 answer recharge_required. Check a candidate with pnpm bench:models
AISA_BASE_URL=https://api.aisa.one/v1
AGENT_LLM_TIMEOUT_MS=8000       # ms without a real stream part before the scripted fallback; only fires while no tool has run, so a payment cannot run twice
