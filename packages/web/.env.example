# URLs (use the laptop LAN IP so a phone on the same network can reach both)
NEXT_PUBLIC_APP_URL=http://localhost:3000       # baked into the printed QR
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Payer app
NEXT_PUBLIC_DEMO_KEY=0x<key>                    # pinned demo account; 0/unset = connected wallet only. NEXT_PUBLIC_* is inlined into the client bundle, so this key is PUBLIC — testnet demo funds only, never the relayer's

# WalletConnect (free at cloud.walletconnect.com; only the WC modal needs it)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
