# URLs (use the laptop LAN IP so a phone on the same network can reach both)
NEXT_PUBLIC_APP_URL=http://localhost:3000       # baked into the printed QR
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Payer page
NEXT_PUBLIC_BURNER=0|1                          # default: 0 — burner also activates via ?burner=1
NEXT_PUBLIC_BURNER_KEY                          # optional pre-funded stage key; unset = per-device localStorage key + faucet
NEXT_PUBLIC_PAY_TOKEN=USDC|MUSDC|XSGD           # default: USDC — wallet-connect path token (burner always MUSDC)

# WalletConnect (free at cloud.walletconnect.com; only the WC modal needs it)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
