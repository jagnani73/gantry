# URLs (LAN IP for a phone demo; inlined at BUILD time, so redeploy after a change)
NEXT_PUBLIC_APP_URL=http://localhost:3000       # baked into the printed QR
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000   # a localhost value on a deployed build fetches the visitor's own machine

# Payer app
NEXT_PUBLIC_DEMO_KEY!                           # pinned demo account; 0/unset = connected wallet only. Inlined, so PUBLIC: testnet funds only, never the relayer's

# WalletConnect (free at cloud.walletconnect.com; only the WC modal needs it)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID!
