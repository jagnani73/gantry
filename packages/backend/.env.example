# Chain
CHAIN_ID=84532|31337            # default: 84532
BASE_SEPOLIA_RPC_URL!           # comma-separated, tried in order; https://sepolia.base.org is always appended
BASE_SEPOLIA_WS_URL             # defaults to the FIRST rpc url with wss:// (works for Alchemy)
ANVIL_RPC_URL=http://127.0.0.1:8545
RELAYER_PRIVATE_KEY!            # the ONLY gas key — payers never send transactions

# Addresses (31337 only; 84532 pinned in @gantry/shared)
GANTRY_CORE_ADDRESS
FIXED_RATE_SWAP_ADDRESS
MOCK_USDC_ADDRESS
MOCK_XSGD_ADDRESS

# API
PORT=4000
CORS_ORIGIN=*
ADMIN_TOKEN!
FAUCET_ENABLED=0|1              # default: 1 — relayer mints MockUSDC to burner payers
ONBOARDING_ENABLED=0|1          # default: 0 — set 1 ONLY on the demo laptop (relayer pays registration gas)
INTENT_TTL_SECONDS=600
DB_PATH=./gantry.db
DEFAULT_TOKEN=MUSDC|USDC|XSGD   # default: MUSDC

# x402 agent door
ORDER_TOKEN=MUSDC|USDC          # default: USDC when the chain has real USDC, else MUSDC — the 402 offer asset

# gantry-pbm (M3)
PBM_WALLET_ADDRESS              # overrides the shared demo wallet pin (31337, or a fresh deploy)
POLICY_ADMIN_ENABLED=0|1        # default: 1 — set 0 on PUBLIC hosts (open revoke = demo kill switch)
