# Chain
BASE_SEPOLIA_RPC_URL!           # comma-separated, tried in order; https://sepolia.base.org is always appended
BASE_SEPOLIA_WS_URL             # defaults to the FIRST rpc url with wss:// (works for Alchemy)
RELAYER_PRIVATE_KEY!            # the ONLY gas key AND the USDC funder — payers never send transactions

# API
PORT=4000
APP_URL                         # where /pay/:handle sends a browser, e.g. https://gantry-innovatex.vercel.app. REQUIRED on a public host: unset, the redirect is derived only for a private/loopback host and a public one 500s PayLinkNotConfigured
APP_PORT=3000                   # payer-app port, used only when APP_URL is unset
CORS_ORIGIN=*|https://gantry-innovatex.vercel.app   # default: * — set the origin on a deployed host
ADMIN_TOKEN!                    # x-admin-token header; exempts operator calls (demo-reset seeding) from the gates below

# Host class
NODE_ENV=development|production  # default: development. `production` caps the payer faucet at 20 USDC + 0.01 ETH per rolling 24h. Merchant writes are metered on EVERY host (20 registrations, 60 profile edits, 10 edits per shop, per rolling 24h) — x-admin-token exempts an operator
ONBOARDING=open|closed          # default: open. `closed` is the abuse kill switch — a registration is permanent and public, so the ceiling alone cannot undo one
PROFILE_EDITS=open|closed       # default: open. Separate switch on purpose: defacing shop names is a reason to stop edits and no reason to stop new shops joining

# e2e scripts (optional; a fresh key is generated and funded when unset)
GANTRY_API=http://localhost:4000  # the backend e2e:pay and x402:buy talk to
E2E_PAYER_KEY                   # pins the human-door payer for e2e:pay
X402_PAYER_KEY                  # pins the vanilla x402 client's payer for x402:buy
