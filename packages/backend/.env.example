# Chain
BASE_SEPOLIA_RPC_URL!           # comma-separated, tried in order; https://sepolia.base.org is always appended
BASE_SEPOLIA_WS_URL             # defaults to the FIRST rpc url with wss:// (works for Alchemy)
RELAYER_PRIVATE_KEY!            # the ONLY gas key AND the USDC funder — payers never send transactions

# API
PORT=4000
CORS_ORIGIN=*|https://gantry-innovatex.vercel.app   # default: * — set the origin on a deployed host
ADMIN_TOKEN!                    # x-admin-token header; exempts operator calls (demo-reset seeding) from the gates below

# Host class
NODE_ENV=development|production  # default: development. `production` caps the payer faucet at 20 USDC + 0.01 ETH per rolling 24h, turns self-service onboarding OFF, and closes unauthenticated profile editing

# e2e scripts (optional; a fresh key is generated and funded when unset)
E2E_PAYER_KEY                   # pins the human-door payer for e2e:pay
X402_PAYER_KEY                  # pins the vanilla x402 client's payer for x402:buy
