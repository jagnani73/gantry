# Chain
BASE_SEPOLIA_RPC_URL!           # comma-separated, tried in order; https://sepolia.base.org is always appended
BASE_SEPOLIA_WS_URL             # defaults to the FIRST rpc url with wss:// (works for Alchemy)
RELAYER_PRIVATE_KEY!            # the ONLY gas key AND the USDC funder — payers never send transactions

# API
PORT=4000
CORS_ORIGIN=*
ADMIN_TOKEN!

# Host class
NODE_ENV=development|production  # default: development — `production` caps the payer faucet at 20 USDC/24h and turns self-service onboarding OFF

# gantry-pbm (M3)
POLICY_ADMIN_ENABLED=0|1        # default: 1 — set 0 on PUBLIC hosts (open revoke = demo kill switch)
