# Deploy
PRIVATE_KEY!
BASE_SEPOLIA_RPC_URL!   # SINGLE url — forge/foundry.toml cannot parse the backend's comma-separated form
ETHERSCAN_API_KEY!

# Existing deployment the seed/PBM scripts run against
GANTRY_CORE_ADDRESS!    # deployed core; the scripts never redeploy it

# SeedDemo (optional)
MERCHANT_PAYOUT         # demo merchant payout address; defaults to deployer (script warns)

# DeployPBM (M3)
AGENT_SIGNER_ADDRESS!   # agent session key's address (from packages/agent AGENT_SESSION_KEY)
GADGETHUB_PAYOUT        # rejection-beat merchant payout; defaults to deployer (script warns)
