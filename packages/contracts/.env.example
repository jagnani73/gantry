# Deploy — read by DeployAll.s.sol (PRIVATE_KEY) and scripts/contracts-fresh.mjs
PRIVATE_KEY!            # MUST be the backend's relayer key, or the new core's onlyRelayer is wrong forever
BASE_SEPOLIA_RPC_URL!   # SINGLE url — forge/foundry.toml cannot parse the backend's comma-separated form
ETHERSCAN_API_KEY!      # verification; contracts-fresh refuses to run without it unless --skip-verify
